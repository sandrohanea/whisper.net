<Project Sdk="Microsoft.NET.Sdk">

  <!-- Whisper.net.Runtime cannot be referenced in MAUI ios dependency project that is only targetting net8.0 or net9.0 as it will copy the runtimes for linux, mac and windows and will cause the build to fail. -->

 <Import Condition="$(USE_WHISPER_NOAVX_TESTS) != ''"
          Project="../../runtimes/Whisper.net.Runtime.NoAvx/Whisper.net.Runtime.NoAvx.targets" />
  <Import Condition="$(USE_WHISPER_NOAVX_TESTS) != ''"
          Project="../../runtimes/Whisper.net.Runtime.Parakeet.NoAvx/Whisper.net.Runtime.Parakeet.NoAvx.targets" />

  <!-- Imported before Whisper.net.Runtime.targets (rather than relying on Whisper.net.Runtime.Parakeet.targets'
       own default further below) so WhisperNetGgmlRuntimeProvider is set before Whisper.net.Runtime.targets'
       static ggml Apple/WASM NativeReference conditions are evaluated, mirroring the props-before-targets
       ordering NuGet guarantees for a real PackageReference consumer. -->
  <Import Condition="$(USE_WHISPER_MAUI_TESTS) == ''
      AND $(USE_WHISPER_NOAVX_TESTS) == ''"
          Project="../../runtimes/Whisper.net.Runtime.Parakeet/Whisper.net.Runtime.Parakeet.props" />
  <Import Condition="$(USE_WHISPER_MAUI_TESTS) == ''
      AND $(USE_WHISPER_NOAVX_TESTS) == ''"
          Project="../../runtimes/Whisper.net.Runtime/Whisper.net.Runtime.targets" />
  <Import Condition="$(USE_WHISPER_MAUI_TESTS) == ''
      AND $(USE_WHISPER_NOAVX_TESTS) == ''"
          Project="../../runtimes/Whisper.net.Runtime.Metal/Whisper.net.Runtime.Metal.targets" />
  <Import Condition="$(USE_WHISPER_MAUI_TESTS) == ''
      AND $(USE_WHISPER_NOAVX_TESTS) == ''"
          Project="../../runtimes/Whisper.net.Runtime.Parakeet/Whisper.net.Runtime.Parakeet.targets" />
  <Import Condition="$(USE_WHISPER_MAUI_TESTS) == ''
      AND $(USE_WHISPER_NOAVX_TESTS) == ''"
          Project="../../runtimes/Whisper.net.Runtime.Parakeet.Metal/Whisper.net.Runtime.Parakeet.Metal.targets" />

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>13</LangVersion>
		<IsTestProject>true</IsTestProject>
    <!-- dotnet test runs target frameworks in parallel by default. Each TFM is a full native inference test run, and Windows CI has left one testhost stuck before producing its TRX when multiple TFMs run at once. Keep TFM execution sequential so the suite's native concurrency stays bounded. -->
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <NoWarn>xUnit1041</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.Extensions.AssemblyFixture" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

		<PackageReference Include="coverlet.collector">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>


  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) AND $(USE_WHISPER_NOAVX_TESTS) == ''">
    <TargetFrameworks>
      net9.0;net10.0;net48;
    </TargetFrameworks>
  </PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Whisper.net\Whisper.net.csproj" />
	</ItemGroup>

  <Target Name="EnsureNativeRuntimesAreAvailable"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(USE_WHISPER_MAUI_TESTS)' == ''">
    <ItemGroup Condition="'$(USE_WHISPER_NOAVX_TESTS)' != ''">
      <_WhisperNativeRuntimeFile Include="$(MSBuildThisFileDirectory)..\..\runtimes\Whisper.net.Runtime.NoAvx\**\*"
                                 Exclude="$(MSBuildThisFileDirectory)..\..\runtimes\Whisper.net.Runtime.NoAvx\*.targets" />
      <_ParakeetNativeRuntimeFile Include="$(MSBuildThisFileDirectory)..\..\runtimes\Whisper.net.Runtime.Parakeet.NoAvx\**\*"
                                 Exclude="$(MSBuildThisFileDirectory)..\..\runtimes\Whisper.net.Runtime.Parakeet.NoAvx\*.targets" />
    </ItemGroup>
    <ItemGroup Condition="'$(USE_WHISPER_NOAVX_TESTS)' == ''">
      <_WhisperNativeRuntimeFile Include="$(MSBuildThisFileDirectory)..\..\runtimes\Whisper.net.Runtime\**\*"
                                 Exclude="$(MSBuildThisFileDirectory)..\..\runtimes\Whisper.net.Runtime\*.targets" />
      <_ParakeetNativeRuntimeFile Include="$(MSBuildThisFileDirectory)..\..\runtimes\Whisper.net.Runtime.Parakeet\**\*"
                                 Exclude="$(MSBuildThisFileDirectory)..\..\runtimes\Whisper.net.Runtime.Parakeet\*.targets;$(MSBuildThisFileDirectory)..\..\runtimes\Whisper.net.Runtime.Parakeet\*.props" />
    </ItemGroup>
    <Error Condition="'@(_WhisperNativeRuntimeFile)' == ''"
           Text="Native runtimes are missing. Run 'dotnet run --project tools/RestoreNativeLibraries' from the repository root, then retry. Preview runtimes are only suitable for managed-only changes." />
    <Error Condition="'@(_ParakeetNativeRuntimeFile)' == ''"
           Text="Parakeet native runtimes are missing. Build the Parakeet runtime from the changed native sources, then retry." />
  </Target>

  <!-- Files cannot be copied without PublishFolderType on MAUI, and test data is embedded as MauiAsset there -->
	<ItemGroup Condition="$(USE_WHISPER_MAUI_TESTS) == ''">
    <None Include="..\TestData\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <LogicalName>(Filename)%(Extension)</LogicalName>
    </None>
	</ItemGroup>

</Project>
