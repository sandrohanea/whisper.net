    <NativeReference Include="$(MSBuildThisFileDirectory)ios-device\libggml-blas-parakeet.a" Condition="'$(WhisperNetGgmlRuntimeProvider)' == 'Parakeet' And Exists('$(MSBuildThisFileDirectory)ios-device\libggml-blas-parakeet.a')">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <Frameworks>Accelerate</Frameworks>
    </NativeReference>
    <NativeReference Include="$(MSBuildThisFileDirectory)ios-device\libggml-metal-parakeet.a" Condition="'$(WhisperNetGgmlRuntimeProvider)' == 'Parakeet' And Exists('$(MSBuildThisFileDirectory)ios-device\libggml-metal-parakeet.a')">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <Frameworks>Metal</Frameworks>
    </NativeReference>
