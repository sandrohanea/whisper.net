<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WhisperNetGgmlRuntimeProvider Condition="'$(WhisperNetGgmlRuntimeProvider)' == ''">Parakeet</WhisperNetGgmlRuntimeProvider>
  </PropertyGroup>

  <ItemGroup Condition="(('$(Platform)' == 'iPhoneSimulator') OR $(RuntimeIdentifier.StartsWith('iossimulator')))">
    <NativeReference Include="$(MSBuildThisFileDirectory)ios-simulator\libparakeet.a" Condition="Exists('$(MSBuildThisFileDirectory)ios-simulator\libparakeet.a')">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <ForceLoad>true</ForceLoad>
      <Frameworks>Accelerate Metal</Frameworks>
    </NativeReference>
    <NativeReference Include="$(MSBuildThisFileDirectory)ios-simulator\libggml-parakeet.a" Condition="'$(WhisperNetGgmlRuntimeProvider)' == 'Parakeet' And Exists('$(MSBuildThisFileDirectory)ios-simulator\libggml-parakeet.a')">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
    <NativeReference Include="$(MSBuildThisFileDirectory)ios-simulator\libggml-base-parakeet.a" Condition="'$(WhisperNetGgmlRuntimeProvider)' == 'Parakeet' And Exists('$(MSBuildThisFileDirectory)ios-simulator\libggml-base-parakeet.a')">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
    <NativeReference Include="$(MSBuildThisFileDirectory)ios-simulator\libggml-cpu-parakeet.a" Condition="'$(WhisperNetGgmlRuntimeProvider)' == 'Parakeet' And Exists('$(MSBuildThisFileDirectory)ios-simulator\libggml-cpu-parakeet.a')">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
    <NativeReference Include="$(MSBuildThisFileDirectory)ios-simulator\libggml-blas-parakeet.a" Condition="'$(WhisperNetGgmlRuntimeProvider)' == 'Parakeet' And Exists('$(MSBuildThisFileDirectory)ios-simulator\libggml-blas-parakeet.a')">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <Frameworks>Accelerate</Frameworks>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="(('$(Platform)' == 'iPhone') OR ('$(RuntimeIdentifier)' == 'ios') OR $(RuntimeIdentifier.StartsWith('ios-')) OR $(RuntimeIdentifier.StartsWith('ios.')))">
    <NativeReference Include="$(MSBuildThisFileDirectory)ios-device\libparakeet.a" Condition="Exists('$(MSBuildThisFileDirectory)ios-device\libparakeet.a')">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <ForceLoad>true</ForceLoad>
