    <NativeReference Include="$(MSBuildThisFileDirectory)tvos-simulator\libggml-blas-parakeet.a" Condition="'$(WhisperNetGgmlRuntimeProvider)' == 'Parakeet' And Exists('$(MSBuildThisFileDirectory)tvos-simulator\libggml-blas-parakeet.a')">
      <Kind>Static</Kind>
      <SmartLink>true</SmartLink>
      <Frameworks>Accelerate</Frameworks>
    </NativeReference>
