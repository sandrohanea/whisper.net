<?xml version="1.0"?>
<package>
  <metadata>
    <id>Whisper.net.AllRuntimes</id>
    <title>Whisper.Net.AllRuntimes</title>
    <version>$version$</version>
    <authors>Sandro Hanea</authors>
    <owners>Sandro Hanea</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>All native runtimes for Whisper.net.</summary>
    <description>Whisper.net.AllRuntimes includes the native Whisper and Parakeet runtime package families for CPU and supported GPU backends.</description>
    <tags>whisper;parakeet;cuda;vulkan;gpu;cpu;</tags>
    <projectUrl>https://github.com/sandrohanea/whisper.net</projectUrl>
    <license type="expression">MIT</license>
    <readme>content/readme.md</readme>
    <dependencies>
      <dependency id="Whisper.net" version="$version$" />
      <dependency id="Whisper.net.Runtime" version="$version$" />
      <dependency id="Whisper.net.Runtime.Cuda" version="$version$" />
      <dependency id="Whisper.net.Runtime.Cuda12" version="$version$" />
      <dependency id="Whisper.net.Runtime.CoreML" version="$version$" />
      <dependency id="Whisper.net.Runtime.Metal" version="$version$" />
      <dependency id="Whisper.net.Runtime.NoAvx" version="$version$" />
      <dependency id="Whisper.net.Runtime.OpenVino" version="$version$" />
      <dependency id="Whisper.net.Runtime.Vulkan" version="$version$" />
      <dependency id="Whisper.net.Runtime.Parakeet" version="$version$" />
      <dependency id="Whisper.net.Runtime.Parakeet.Cuda" version="$version$" />
      <dependency id="Whisper.net.Runtime.Parakeet.Cuda12" version="$version$" />
      <dependency id="Whisper.net.Runtime.Parakeet.Metal" version="$version$" />
      <dependency id="Whisper.net.Runtime.Parakeet.NoAvx" version="$version$" />
      <dependency id="Whisper.net.Runtime.Parakeet.Vulkan" version="$version$" />
    </dependencies>
  </metadata>
  <files>
    <file src="../readme.md" target="content/readme.md" />
  </files>
</package>
